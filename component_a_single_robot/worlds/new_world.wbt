WorldInfo {
  basicTimeStep 32
}
Viewpoint {
  orientation -0.25 0.72 0.64 0.99
  position -6.13 -3.40 6.97
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 10 10
}

# --- OBSTACLES ---
SolidBox {
  translation -2.0 -1.0 0.25
  size 3 0.5 0.5
  name "obs_1"
}
SolidBox {
  translation 1.0 1.5 0.25
  size 0.5 3 0.5
  name "obs_2"
}

# --- ROBOT & SENSORS ---
E-puck {
  translation -4.0 0.0 0.02
  rotation 0 0 1 0
  name "e-puck"
  controller "a_robot_controller"
  turretSlot [
    Compass {
      name "compass"
    }
    GPS {
      name "gps"
    }
    Lidar {
      name "lidar"
      horizontalResolution 360
      fieldOfView 3.14
      numberOfLayers 1
      minRange 0.05
      maxRange 8
    }
  ]
}